<% layout('/layouts/boilerplate') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

      <div class="card shadow-lg p-4 rounded-4">

        <h4 class="text-center mb-4">Confirm Your Booking</h4>

        <img src="<%= booking.listing.image.url %>"
             class="img-fluid rounded-3 mb-3"
             style="height:220px; width: 100%; object-fit:cover;">

        <p><strong>Location:</strong>
          <%= booking.listing.location %>, <%= booking.listing.country %>
        </p>

        <p><strong>Check-In:</strong>
          <%= booking.checkIn.toDateString() %>
        </p>

        <p><strong>Check-Out:</strong>
          <%= booking.checkOut.toDateString() %>
        </p>

        <p><strong>Price per night:</strong>
          ₹<%= booking.listing.price %>
        </p>

        <hr>

        <h4 class="mt-3 text-success fw-bold text-center">
          Total: ₹<%= booking.totalPrice %>
        </h4>

        <div class="d-flex gap-2 mt-3">
  
            <form action="/bookings/confirm/<%= booking._id %>" method="POST" class="w-50">
                <button class="btn btn-success w-100">Pay Now</button>
            </form>

            <a href="/listings/<%= booking.listing._id %>" 
                class="btn btn-outline-secondary w-50">
                Cancel
            </a>

        </div>

      </div>

    </div>
  </div>
</div>